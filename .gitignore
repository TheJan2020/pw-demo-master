# Python
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Project state — contains tokens & API keys, must not be committed
data/state.json

# Per-vertical demo runtime state. Most of this stays per-machine
# (recordings have caller PII, snapshot.json has patient PII,
# escalation.json has the AMI password + Wasender API key). The
# exceptions are persona.txt and kb.txt — they're content, not state
# or secrets, written by the SPA's "Apply to Live Agent" button — so
# they ARE tracked by git, which keeps both machines in sync without
# anyone having to re-click Apply after a pull. See CLAUDE.md.
data/demos/*/calls/
data/demos/*/snapshot.json
data/demos/*/snapshot.json.tmp
data/demos/*/escalation.json
data/demos/*/escalation.json.tmp

# AI-Camera runtime — snapshot images + iteration logs accumulate
# constantly; not source.
data/ai_camera/

# Claude Code's local-only permission settings — per-machine, not source.
.claude/settings.local.json

# Node (in case we add it later)
node_modules/

# Editor / IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs / scratch
*.log
/tmp/
